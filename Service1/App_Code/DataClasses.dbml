      <Column Name="QuantityBought" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
      <Association Name="Invoice_ProdIDQtyBought" Member="Invoice" ThisKey="InvoiceID" OtherKey="InvoiceID" Type="Invoice" IsForeignKey="true" />
      <Association Name="Product_ProdIDQtyBought" Member="Product" ThisKey="ProductID" OtherKey="Prod_Id" Type="Product" IsForeignKey="true" />
    </Type>
  </Table>
