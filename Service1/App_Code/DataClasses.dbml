      <Association Name="UserTable_Invoice" Member="UserTable" ThisKey="UserID" OtherKey="ID" Type="UserTable" IsForeignKey="true" />
    </Type>
  </Table>
  <Table Name="dbo.ProdIDQtyBought" Member="ProdIDQtyBoughts">
    <Type Name="ProdIDQtyBought">
      <Column Name="InvoiceID" Type="System.Int32" DbType="Int NOT NULL" CanBeNull="false" />
